<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- 1. Bus Number (varchar 20, NOT NULL, UNIQUE) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:fontFamily="sans-serif-medium"
        android:text="Bus Number"
        android:textColor="#334155"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/busNumber"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_input_field"
        android:hint="Enter bus number (e.g., MH12AB1234)"
        android:inputType="textCapCharacters"
        android:maxLength="20"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="#0F172A"
        android:textColorHint="#94A3B8"
        android:textSize="14sp" />

    <!-- 2. Bus Name (varchar 20, NOT NULL) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:fontFamily="sans-serif-medium"
        android:text="Bus Name"
        android:textColor="#334155"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/busName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_input_field"
        android:hint="Enter bus name"
        android:inputType="text"
        android:maxLength="20"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="#0F172A"
        android:textColorHint="#94A3B8"
        android:textSize="14sp" />

    <!-- 3. Bus Type (varchar 20) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:fontFamily="sans-serif-medium"
        android:text="Bus Type"
        android:textColor="#334155"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/busType"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_input_field"
        android:hint="e.g. AC, Non-AC, Sleeper"
        android:inputType="text"
        android:maxLength="20"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="#0F172A"
        android:textColorHint="#94A3B8"
        android:textSize="14sp" />

    <!-- 4. Bus Capacity (int, NOT NULL) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:fontFamily="sans-serif-medium"
        android:text="Bus Capacity"
        android:textColor="#334155"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/busCapacity"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_input_field"
        android:hint="Enter total seats"
        android:inputType="number"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="#0F172A"
        android:textColorHint="#94A3B8"
        android:textSize="14sp" />

    <!-- Submit Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/busSubmitBtn"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_primary_button"
        android:fontFamily="sans-serif-medium"
        android:padding="12dp"
        android:text="Add Bus"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp" />

</LinearLayout>